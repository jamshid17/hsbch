# DATABASE_URL is derived automatically from POSTGRES_* (see app/config.py).
POSTGRES_USER=hsbch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hsbch

ANTHROPIC_API_KEY=sk-ant-...
BOT_TOKEN=123456:ABC-...
WEBAPP_URL=https://hsbch.uz
TELEGRAM_WEBHOOK_SECRET=some-long-random-string

# Subscription period and free allowance.
SUBSCRIPTION_DAYS=30
FREE_TOTAL_SCANS=5
# Comma-separated Telegram user ids that get the in-app admin panel.
ADMIN_TELEGRAM_IDS=

# Manual card payments (leave CARD_NUMBER empty to hide the card block).
CARD_NUMBER=8600 0000 0000 0000
CARD_HOLDER=JAVOHIR HASANOV
SUBSCRIPTION_PRICE_UZS=30000
ADMIN_CONTACT=hsbchadmin

# Master switch for the paid tier. false = the app is fully free: no quota,
# no paywall, no card block, and the admin panel hides its subscription
# controls. Nothing is deleted — set it to true to turn the paid tier back on.
SUBSCRIPTIONS_ENABLED=false
# Max receipt upload size in MB. Keep in step with client_max_body_size on
# nginx's /api/ location.
MAX_UPLOAD_MB=5

# Accept an unsigned X-Telegram-User-Id header instead of validating Telegram's
# signed initData. Local browser testing only — with this on, anyone can call
# the API as any user just by naming an id. Leave it unset in production;
# the default is false.
# DEV_ALLOW_UNSAFE=false

# Extra browser origins allowed to call the API cross-origin, comma separated.
# Normally empty: nginx serves the Mini App and the API from one origin, so
# nothing is cross-origin. WEBAPP_URL is always allowed.
# CORS_EXTRA_ORIGINS=
